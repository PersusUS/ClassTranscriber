# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# HuggingFace read token. Only needed for speaker diarization, i.e. to
# isolate the professor's voice. Without it you can still transcribe
# everything with:  python main.py run --name clase --no-diarize
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional overrides (defaults shown) ------------------------------

# Resource profile: low | balanced | quality | auto
# CT_PROFILE=auto

# Class language, ISO 639-1
# CT_LANGUAGE=es

# Where Ollama is listening
# OLLAMA_HOST=http://localhost:11434

# Log verbosity: DEBUG | INFO | WARNING
# CT_LOG_LEVEL=INFO
